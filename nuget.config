<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--To inherit the global NuGet package sources remove the <clear/> line below -->
    <clear />
    <add key="nuget" value="https://api.nuget.org/v3/index.json" />
    <!-- Private feed hosting InferenceEngine.Core (AGPL-3.0-or-later) -->
    <add key="github-intel-agency" value="https://nuget.pkg.github.com/intel-agency/index.json" />
    <!-- <add key="nexus-group" value="http://localhost:8081/repository/nuget-group/index.json" allowInsecureConnections="True" /> -->
  </packageSources>
  <!--
    GitHub Packages requires authentication even to read. The token is supplied via
    the NUGET_AUTH_TOKEN environment variable (a GitHub PAT with read:packages scope).
    In CI, pass GITHUB_TOKEN as NUGET_AUTH_TOKEN. DO NOT commit real credentials here.
  -->
  <packageSourceCredentials>
    <github-intel-agency>
      <add key="Username" value="x-access-token" />
      <add key="ClearTextPassword" value="%NUGET_AUTH_TOKEN%" />
    </github-intel-agency>
  </packageSourceCredentials>
</configuration>
