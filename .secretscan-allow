# Repo-local suppression for scan-uncommitted-secrets (scripts/scan.sh).
# Format: one rule per line. Two kinds:
#   path:<glob>   suppress all findings in file paths matching the glob
#   line:<regex>  suppress findings whose raw offending line matches this ERE
# Blank lines and lines starting with '#' are ignored. Keep this list small and
# specific; each entry should be a confirmed false positive with a comment.

# ML tokenizer fields, NOT auth tokens. The scanner's key-name detector flags
# any assignment whose key contains the substring "token"; "tokenizer" and
# "tokenizersPath" (Microsoft.ML.Tokenizers / local tokenizer vocab paths) trip
# it. These are assignment statements, so line-pattern suppression is robust to
# the lines moving as the files are edited.
line:_tokenizer[[:space:]]*=
line:_tokenizersPath[[:space:]]*=

# AI generation max-token count (AiSettings.MaxTokens), NOT an auth token. Same
# key-name detector trips on any assignment whose key contains "token".
line:MaxTokens[[:space:]]*=

# GitHub Actions secret *references* (${{ secrets.NAME }}), not hardcoded credentials.
# The scanner flags NUGET_AUTH_TOKEN / GH_TOKEN assignment keys in workflows; the
# values are Actions expressions that resolve at runtime from repo secrets.
line:\$\{\{[[:space:]]*secrets\.[A-Z0-9_]+[[:space:]]*\}\}
